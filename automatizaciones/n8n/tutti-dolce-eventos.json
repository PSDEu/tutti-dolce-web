{
  "name": "Tutti Dolce · eventos de la API",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "tutti-dolce",
        "options": {}
      },
      "name": "Evento de la API",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "id": "webhook",
      "webhookId": "tutti-dolce"
    },
    {
      "parameters": {
        "mode": "expression",
        "numberOutputs": 3,
        "output": "={{ ({ 'diseno.compartible': 0, 'borrador.aprobado': 1 })[$json.body.evento] ?? 2 }}"
      },
      "name": "Según el evento",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        240,
        300
      ],
      "id": "switch"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.ANTHROPIC_API_KEY }}"
            },
            {
              "name": "anthropic-version",
              "value": "2026-10-21"
            },
            {
              "name": "anthropic-beta",
              "value": "server-side-fallback-2026-07-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'claude-opus-5-5', max_tokens: 2000, output_config: { effort: 'low' }, fallbacks: 'default', system: \"Eres la community manager de Tutti Dolce, una pastelería artesanal. Escribes publicaciones para Instagram con la voz de la dueña: cálida, cercana, artesanal y elegante sin ser fría. Frases cortas, un toque de humor suave, como mucho 2 o 3 emojis y entre 3 y 6 hashtags al final.\\n\\nAsí escribe la dueña (ejemplos reales; sustitúyelos por 5–10 publicaciones suyas):\\n<ejemplos>\\n[PEGAR AQUÍ PUBLICACIONES REALES DE LA DUEÑA]\\n</ejemplos>\\n\\nReglas:\\n- Habla del diseño de la torta (forma, sabores, decoración) como algo que diseñó un cliente en la web.\\n- Nunca menciones nombres, datos personales ni el mensaje escrito en la torta.\\n- Termina invitando a diseñar la suya en la web.\\n- Devuelve solo el texto de la publicación, sin comillas ni explicaciones.\", messages: [{ role: 'user', content: 'Escribe la publicación para este diseño de torta (JSON del configurador): ' + JSON.stringify($json.body.datos.diseno) }] }) }}"
      },
      "name": "Claude escribe el borrador",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        160
      ],
      "id": "claude-escribe-el-borrador"
    },
    {
      "parameters": {
        "jsCode": "// Comprueba que Claude no rechazó la petición y junta los bloques de texto.\nconst r = $input.first().json;\nif (r.stop_reason === 'refusal') {\n  throw new Error('Claude no escribió el borrador (refusal): ' + JSON.stringify(r.stop_details));\n}\nconst texto = (r.content || []).filter(b => b.type === 'text').map(b => b.text).join('\n').trim();\nif (!texto) throw new Error('Respuesta sin texto');\nconst evento = $('Evento de la API').first().json.body;\nreturn [{ json: { disenoCodigo: evento.datos.codigo, red: 'instagram', texto } }];"
      },
      "name": "Sacar el texto",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        160
      ],
      "id": "texto"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.TUTTI_API_URL }}/api/admin/borradores",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Admin-Key",
              "value": "={{ $env.TUTTI_ADMIN_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}"
      },
      "name": "Guardar borrador en la API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1040,
        160
      ],
      "id": "guardar-borrador-en-la-api"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $env.INSTAGRAM_USER_ID }}/media",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ caption: $json.body.datos.texto, image_url: $env.TUTTI_API_URL + '/api/disenos/imagen/' + $json.body.datos.disenoCodigo, access_token: $env.INSTAGRAM_TOKEN }) }}"
      },
      "name": "Publicar en Instagram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        420
      ],
      "id": "publicar-en-instagram",
      "disabled": true,
      "notes": "Desactivado hasta tener cuenta de empresa de Instagram, token y URL pública de imagen. Ver docs/automatizaciones.md."
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.TUTTI_API_URL }}/api/admin/borradores/{{ $('Evento de la API').first().json.body.datos.id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Admin-Key",
              "value": "={{ $env.TUTTI_ADMIN_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ texto: $('Evento de la API').first().json.body.datos.texto, estado: 'PUBLICADO' }) }}"
      },
      "name": "Marcar como publicado",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        420
      ],
      "id": "marcar-como-publicado",
      "disabled": true,
      "notes": "Actívalo a la vez que 'Publicar en Instagram' (si no, marcaría como publicado sin publicar)."
    }
  ],
